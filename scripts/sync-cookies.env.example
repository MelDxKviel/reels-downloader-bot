# ── Конфигурация scripts/sync_cookies.py ─────────────────────────────────────
# Скопируй в .env.sync (рядом с проектом) и заполни. Скрипт сам подхватит
# .env.sync, либо .env. Любую переменную можно задать и через окружение —
# реальное окружение имеет приоритет над файлом.
#
#   cp scripts/sync-cookies.env.example .env.sync

# ── Сервер (SSH) ─────────────────────────────────────────────────────────────
# Те же координаты, что в секретах GitHub Actions DEPLOY_* (.github/workflows/cd.yml).
DEPLOY_HOST=your.server.com          # хост/IP сервера с ботом                (обязательно)
DEPLOY_USER=deploy                   # SSH-пользователь                       (обязательно)
DEPLOY_PATH=/opt/reels-downloader-bot # папка с docker-compose.yml на сервере (обязательно)
DEPLOY_PORT=22                       # SSH-порт                               (необязательно)

# Аутентификация — выбери ОДИН способ:
#  • по ключу (по умолчанию): оставь DEPLOY_PASSWORD пустым, используется системный ssh
#    (ключ из ssh-agent или указанный в DEPLOY_KEY). Никаких доп. зависимостей.
#  • по паролю: задай DEPLOY_PASSWORD — скрипт переключится на paramiko (одно соединение,
#    пароль вводится один раз). Нужен пакет paramiko, см. scripts/README.md.
# если в пароле есть пробел или '#', возьми его в кавычки: DEPLOY_PASSWORD="p@ss #1"
DEPLOY_PASSWORD=                     # пароль SSH (включает режим paramiko)
DEPLOY_KEY=                          # путь к приватному ключу (для ключевого режима)
# DEPLOY_KEY_PASSPHRASE=             # passphrase к ключу, если он зашифрован (только paramiko)
# USE_PARAMIKO=0                     # 1 = форсить paramiko даже без пароля
# SSH_EXTRA_OPTS=-o ProxyJump=bastion # доп. опции системного ssh (только ключевой режим)

# ── Откуда брать куки (браузер) ──────────────────────────────────────────────
# yt-dlp вытащит куки прямо из браузера. Поддерживаются:
#   chrome | chromium | edge | brave | opera | vivaldi | firefox | safari
# ВНИМАНИЕ: Chrome/Edge/Brave 127+ шифруют куки (App-Bound Encryption) и yt-dlp
# иногда не может их расшифровать. Если куки не вытаскиваются — используй firefox.
COOKIE_BROWSER=chrome
# COOKIE_BROWSER_PROFILE=Default      # имя/путь профиля (напр. "Profile 1")
# COOKIE_BROWSER_KEYRING=             # только Linux (gnome|kwallet|...)
# COOKIE_BROWSER_CONTAINER=           # только Firefox multi-account containers
# COOKIE_CARRIER_URL=                 # «карьерный» URL для дампа (по умолчанию публичный ролик YouTube)

# ── Какие платформы синкать ──────────────────────────────────────────────────
COOKIE_PLATFORMS=youtube,instagram   # можно одну: youtube  |  instagram

# Пути к файлам куки НА СЕРВЕРЕ (относительно DEPLOY_PATH либо абсолютные).
# Должны совпадать с тем, что монтирует docker-compose.yml — те же имена переменных.
YT_COOKIES_FILE_HOST_PATH=./cookies.txt
INSTA_COOKIES_FILE_HOST_PATH=./instagram-cookies.txt

# ── Перезапуск бота ──────────────────────────────────────────────────────────
# auto   — перезапустить только если куки реально изменились (по умолчанию)
# always — перезапускать всегда
# never  — не трогать бота (куки читаются на лету, рестарт обычно не нужен)
RESTART_BOT=auto
BOT_SERVICE=bot                      # имя сервиса в docker compose
COMPOSE_CMD=docker compose           # или "docker-compose" для старого плагина
# RESTART_CMD=                        # полностью переопределить команду рестарта на сервере

# ── Прочее ───────────────────────────────────────────────────────────────────
# YTDLP_CMD=uv run yt-dlp             # переопределить вызов yt-dlp
COOKIE_SYNC_STRICT=0                  # 1 = падать с ошибкой, если у платформы не нашлось куки
DRY_RUN=0                             # 1 = сухой прогон (то же, что --dry-run)
